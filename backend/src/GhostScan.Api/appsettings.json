{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*"
      }
    }
  },  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GhostScan": "Information"
    }
  },
  "AllowedHosts": "*",
  "GhostScan": {
    "MaxConcurrentScans": 5,
    "DefaultTimeoutSeconds": 300,
    "EnableRealTimeProgress": true
  },
  "Urls": "http://localhost:5000;https://localhost:5001"
}
