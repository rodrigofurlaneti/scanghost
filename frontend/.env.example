# ── GhostScan Frontend — Environment Variables ──────────────────────────────
#
# Copie este arquivo para .env.local (desenvolvimento) ou configure
# no Azure App Service → Configuration → Application Settings (produção).
#
# EM DESENVOLVIMENTO: deixe vazio — o proxy Vite redireciona /api → localhost:5000
# VITE_API_BASE_URL=
#
# EM PRODUÇÃO (Azure): URL do backend sem barra final
# VITE_API_BASE_URL=https://webapplication-scanghost.azurewebsites.net
