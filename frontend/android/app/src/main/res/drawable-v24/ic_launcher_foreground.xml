<?xml version="1.0" encoding="utf-8"?>
<!--
    GhostScan — Ícone foreground com grupo "scan_beam" nomeado para AnimatedVectorDrawable.
    Viewport 108x108 dp. Safe zone: 72x72 centrada em (54,54) → x∈[18,90], y∈[18,90].
    Ghost ocupa ~60x62dp dentro da safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aura / glow externo do ghost -->
    <path
        android:fillColor="#1400FF41"
        android:pathData="M54,21
            C36,21 24,34 24,49
            L24,80
            Q31,91 38,80
            Q45,91 54,80
            Q63,91 70,80
            Q77,91 84,80
            L84,49
            C84,34 72,21 54,21
            Z"/>

    <!-- Corpo principal do ghost (verde matrix) -->
    <path
        android:fillColor="#00FF41"
        android:pathData="M54,26
            C38,26 28,38 28,52
            L28,79
            Q34,88 40,79
            Q46,88 54,79
            Q62,88 68,79
            Q74,88 80,79
            L80,52
            C80,38 70,26 54,26
            Z"/>

    <!-- Reflexo/brilho no topo do ghost (efeito de profundidade) -->
    <path
        android:fillColor="#66FFFFFF"
        android:pathData="M54,28
            C44,28 36,34 33,42
            C38,37 45,34 54,34
            C63,34 70,37 75,42
            C72,34 64,28 54,28
            Z"/>

    <!-- Olho esquerdo (fundo escuro) -->
    <path
        android:fillColor="#061006"
        android:pathData="M37,53 A6,6.5,0,0,1,49,53 A6,6.5,0,0,1,37,53 Z"/>

    <!-- Pupila esquerda (verde brilhante) -->
    <path
        android:fillColor="#00FF41"
        android:pathData="M40,53 A3,3.5,0,0,1,46,53 A3,3.5,0,0,1,40,53 Z"/>

    <!-- Brilho olho esquerdo -->
    <path
        android:fillColor="#CCFFCC"
        android:pathData="M41,50.5 A1.5,1.5,0,0,1,44,50.5 A1.5,1.5,0,0,1,41,50.5 Z"/>

    <!-- Olho direito (fundo escuro) -->
    <path
        android:fillColor="#061006"
        android:pathData="M59,53 A6,6.5,0,0,1,71,53 A6,6.5,0,0,1,59,53 Z"/>

    <!-- Pupila direita (verde brilhante) -->
    <path
        android:fillColor="#00FF41"
        android:pathData="M62,53 A3,3.5,0,0,1,68,53 A3,3.5,0,0,1,62,53 Z"/>

    <!-- Brilho olho direito -->
    <path
        android:fillColor="#CCFFCC"
        android:pathData="M63,50.5 A1.5,1.5,0,0,1,66,50.5 A1.5,1.5,0,0,1,63,50.5 Z"/>

    <!--
        SCAN BEAM GROUP — translateY é animado de -26 a +27 (varre o ghost de topo a base).
        Posição base do beam: y≈52 (centro do ghost).
        Top ghost: y=28 → translateY = 28-52 = -24
        Bottom ghost: y=76 → translateY = 76-52 = +24
    -->
    <group
        android:name="scan_beam"
        android:translateY="0">

        <!-- Glow superior (difuso) -->
        <path
            android:fillColor="#00FF41"
            android:fillAlpha="0.18"
            android:pathData="M28,47 L80,47 L80,51 L28,51 Z"/>

        <!-- Linha principal do beam (branca brilhante) -->
        <path
            android:fillColor="#EEFFEE"
            android:fillAlpha="0.92"
            android:pathData="M28,51 L80,51 L80,53 L28,53 Z"/>

        <!-- Glow inferior (difuso) -->
        <path
            android:fillColor="#00FF41"
            android:fillAlpha="0.18"
            android:pathData="M28,53 L80,53 L80,57 L28,57 Z"/>

    </group>

</vector>
